{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "gdb",
      "request": "launch",
      "name": "Debug (type path)",
      "target": "${workspaceFolder}/${input:binaryPath}",
      "cwd": "${workspaceFolder}",
      "valuesFormatting": "prettyPrinters"
    }
  ],
  "inputs": [
    {
      "id": "binaryPath",
      "type": "promptString",
      "description": "Path to binary, relative to workspace root"
    }
  ]
}
